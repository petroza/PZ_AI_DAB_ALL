# Python / venv / cache
__pycache__/
*.pyc
.venv/
.venv_vox/
.venv_xtts/
runtime/
work/

# Secrety a lokální konfigurace (necommitovat!)
.htpasswd
worker_config.json
*.bak.json
NASTAV_HESLO_ALLDUB.*
prikaldy/
web/config.php
web/data/

# Cloudflare relay – lokální stav a secrety
cloudflare/.wrangler/
cloudflare/.dev.vars
cloudflare/node_modules/

# Zálohy a velká média (ukázky se stahují zvlášť)
*.bak
samples/*
!samples/.gitkeep

# Binárky, modely a hlasy (stahují se zvlášť — viz README)
*.gguf
*.onnx
*.onnx.json
*.exe
*.dll

# Běhová data (placeholdery .gitkeep zůstávají)
uploads/*
outputs/*
jobs/*
logs/*
models/*
tools/*
voices/*
!**/.gitkeep
